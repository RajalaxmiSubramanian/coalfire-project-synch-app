<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
	xmlns:openair="http://www.mulesoft.org/schema/mule/openair"
	xmlns:email="http://www.mulesoft.org/schema/mule/email"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd http://www.mulesoft.org/schema/mule/openair http://www.mulesoft.org/schema/mule/openair/current/mule-openair.xsd http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

	
	<flow name="sf-spp-opportunity-synch-main-flow"
		doc:id="doc-89f9c825" initialState="started">
		<scheduler doc:name="Hourly Scheduler" disallowConcurrentExecution="true"
			doc:id="doc-deb9fbfd"> <scheduling-strategy doc:id="doc-3143bb2b"> <fixed-frequency 
			frequency="${scheduler.frequency}" timeUnit="MINUTES" doc:id="doc-b98f2d36" 
			/> </scheduling-strategy> </scheduler>
		<ee:transform
			doc:name="Set Correlation ID and Run Timestamp" doc:id="doc-eedfee8c">
			<ee:variables doc:id="doc-616e7799">
				<ee:set-variable resource="dwl/read-query-salesforce-object-opportunity.dwl" variableName="querySalesforceObject" />
				<ee:set-variable variableName="failedOpportunitiesList" ><![CDATA[
%dw 2.0
output application/json
---
[]      
 ]]></ee:set-variable>
				<ee:set-variable variableName="runTimestamp" ><![CDATA[%dw 2.0
output application/json
---
now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
        ]]></ee:set-variable>
				<ee:set-variable variableName="correlationId" ><![CDATA[ %dw 2.0
output application/json
---
uuid()
        ]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="86f48db5-b614-4132-abb5-f7f383935d45" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;&quot;correlationId&quot;:vars.correlationId,&#10;&quot;message&quot;: 'Initiated Salesforce Query'&#10;}]"/>
		<flow-ref doc:name="common-salesforce-query-sub-flow" doc:id="cd06ec62-356d-49ca-8494-befebe9b8422" name="common-salesforce-query-sub-flow" />
		<choice doc:name="Choice" doc:id="4cd97c35-1cff-4b4c-9d7f-373145c59113" >
			<when expression="#[!isEmpty(vars.sfError)]">
				<logger level="INFO" doc:name="Logger" doc:id="8ed9a5c6-c52d-436f-9bc9-96999e7d8b8b" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;&quot;correlationId&quot;:vars.correlationId,&#10;&quot;message&quot;: 'Salesforce Opportunity Query Failed. Detailed Error',&#10;&quot;errorDescription&quot; :vars.sfError.description default ''&#10;}]"/>
				<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;"Salesforce Opportunity Query failed: " ++ vars.sfError.description default ""]' doc:name="Set failure reason" doc:id="bbf16718-b96e-405f-81c5-63f2a80302b8" variableName="failureReason"/>
				<raise-error doc:name="APP:PROCESS_ERROR" doc:id="756c921f-f63d-469f-980c-779d02af0c57" type="APP:PROCESS_ERROR" description="#[vars.sfError.description]"/>
			</when>
			<otherwise >
				<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]" doc:name="Set Opportunities Query Result" doc:id="e3e4f366-818c-44a0-a444-cef9b4f33f27" variableName="opportunitiesResult" />
				<logger level="INFO" doc:name="Logger" doc:id="4e1f53d1-d26b-4eed-8e10-4023c090cc32" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;&quot;correlationId&quot;:vars.correlationId,&#10;&quot;message&quot;: 'Salesforce response with opportunities',&#10;&quot;opportunitiesResult&quot; :sizeOf(vars.opportunitiesResult default [])&#10;}]"/>
				<flow-ref doc:name="verify-opportunity-exists-and-process-subflow" doc:id="ee2a8673-db67-4d36-93a8-1b1aa091eb0f" name="verify-opportunity-exists-and-process-subflow" />
			
</otherwise>
		</choice>
		<choice doc:name="Send Failure Notification if Needed"
			doc:id="doc-a951623d">
			<when
				expression="#[sizeOf(vars.failedOpportunitiesList default []) &gt; 0]"
				doc:id="doc-1fafc7de">
				<logger level="INFO" doc:name="Logger" doc:id="fcb3faa3-10bc-4f44-8037-0d4c02fdc682" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;&quot;correlationId&quot;:vars.correlationId,&#10;&quot;message&quot;: 'Failed opportunities exists .Initiating mail notification',&#10;&quot;failedOpportunitiesList&quot; :sizeOf(vars.failedOpportunitiesList default [])&#10;}]" />
				<set-variable value='#[%dw 2.0&#10;output text/plain&#10;---&#10;"&lt;html&gt;&#10;&lt;body&gt;&#10;&lt;p&gt;Hi Team,&lt;/p&gt;&#10;&#10;&lt;p&gt;&#10;The Opportunity Project Sync process has completed.&#10;The following Opportunities failed during processing:&#10;&lt;/p&gt;"&#10;++&#10;(&#10;    (vars.failedOpportunitiesList default [])&#10;        map ((opp) -&gt;&#10;            "&lt;p&gt;&#10;            &lt;b&gt;Opportunity ID:&lt;/b&gt; " ++ (opp.opportunityId default "N/A") ++ "&lt;br/&gt;&#10;            &lt;b&gt;Account ID:&lt;/b&gt; " ++ (opp.accountId default "N/A") ++ "&lt;br/&gt;&#10;            &lt;b&gt;Failure Reason:&lt;/b&gt; " ++ (opp.errorReason  default "N/A") ++&#10;            "&lt;/p&gt;&#10;&#10;            &lt;p&gt;&lt;b&gt;Failed Line Items:&lt;/b&gt;&lt;br/&gt;" ++&#10;            (&#10;                (opp.processResult default [])&#10;                    map ((item) -&gt;&#10;                        "&amp;nbsp;&amp;nbsp;• Line Item ID: " ++&#10;                        (item.opportunityLineItemId default "N/A") ++&#10;                        "&lt;br/&gt;&#10;                        &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SPP Project ID: " ++&#10;                        (item.sppProjectId default "N/A") ++&#10;                        "&lt;br/&gt;&#10;                        &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Error: " ++&#10;                        (item.errorReason default "N/A") ++&#10;                        "&lt;br/&gt;"&#10;                    )&#10;                    joinBy "&lt;br/&gt;"&#10;            ) ++&#10;            "&lt;/p&gt;&#10;            &lt;hr/&gt;"&#10;        )&#10;        joinBy ""&#10;)&#10;++&#10;"&#10;&lt;p&gt;Please review the above Opportunities and take the necessary action.&lt;/p&gt;&#10;&#10;&lt;p&gt;Thanks,&lt;br/&gt;&#10;Integration Team&lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;"]' doc:name="Set mail failure reason" doc:id="fe0656c0-f048-4a8c-bb5f-8870f9b86f15" variableName="emailBody" />
				<flow-ref name="sent-mail-notification-subflow" doc:name="Send Failure Notification" doc:id="doc-537ecf64" />
			</when>
			<otherwise doc:id="doc-f0500f3a">
				<logger level="INFO"
					message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;&quot;correlationId&quot;:vars.correlationId,&#10;&quot;message&quot;: 'No failures — email notification skipped.'&#10;}]"
					category="com.mycompany.sfspp.sf-spp-opportunity-synch-main-flow"
					doc:id="doc-42cc6b13" />
			</otherwise>
		</choice>
		<error-handler ref="globalErrorHandler" />
	
</flow>



</mule>