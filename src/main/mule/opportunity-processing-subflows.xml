<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:openair="http://www.mulesoft.org/schema/mule/openair"
	xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/openair http://www.mulesoft.org/schema/mule/openair/current/mule-openair.xsd http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">

	<sub-flow name="verify-opportunity-exists-and-process-subflow" doc:id="c15a43d8-c44a-44fa-a464-15e12a7c3586" >
		<choice doc:name="Decide Based on SF Query result" doc:id="c88aca60-05b3-4333-838c-2528df908f9e">
			<when expression="#[(sizeOf(payload default []) == 0)]">
				<logger level="INFO" message="#['[correlationId=' ++ vars.correlationId ++ '] No Opportunities to process — ending successfully.']" doc:id="doc-04cc66b3" doc:name="No Opps - End of execution" />
			</when>
			<otherwise>
				<flow-ref doc:name="soap-consumer-login-subflow" doc:id="7a6f2a51-a740-4e65-b89a-b0910d192320" name="soap-consumer-login-subflow" />
				<foreach collection="#[vars.opportunitiesResult]" doc:name="Process Each Opportunity Sequentially" doc:id="doc-f1d44767">
					<try doc:name="Try Process Opportunity" doc:id="doc-dccd9234">
						<ee:transform doc:name="Extract Account Id, Opp Id and current opp." doc:id="f8a070af-7618-4142-9692-7082d371dd84">
							<ee:message>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="accountId"><![CDATA[%dw 2.0
output application/json
---
payload.AccountId default "" ++ "Mule testing1" //Account Id of current executing opportunity]]></ee:set-variable>
								<ee:set-variable variableName="opportunityId"><![CDATA[%dw 2.0
output application/json
---
payload.Id default ""//Opportunity Id of current opportunity]]></ee:set-variable>
								<ee:set-variable variableName="currentOpportunity"><![CDATA[%dw 2.0
output application/json
---
payload //Initialize current opportunity to currentOpportunity Variable]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref name="process-opportunity-subflow" doc:name="Process Opportunity" doc:id="doc-00f7d248" />
						<error-handler doc:id="doc-52fbd2c7">
							<on-error-continue type="ANY" logException="true" doc:id="doc-f8a1a2d5">
								<logger level="ERROR" message="#['[correlationId=' ++ (vars.correlationId default '')]" category="com.mycompany.sfspp.sf-spp-opportunity-synch-main-flow" doc:id="doc-a1cc033d" />
								<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;(vars.failedOpportunitiesList default []) ++ [{&#10;  opportunityId: vars.opportunityId default '',&#10;  accountId: vars.accountId default '',&#10;  sppError: vars.sppError default '' ++ vars.wscError default '',&#10;  failureReason: 'OPPORTUNITY_PROCESSING_FAILED',&#10;  processResult: []&#10;}]]" doc:name="Set failedOpportunitiesList" doc:id="63cda7bc-c1b3-45ce-a088-24e4baa62f9a" variableName="failedOpportunitiesList" />
							</on-error-continue>
						</error-handler>
					</try>
				</foreach>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="process-opportunity-subflow"
		doc:id="doc-876d6dad">
		<try doc:name="Try" doc:id="ebe6ca46-6a78-4a61-bdcd-e412b3fd0412">
			<ee:transform doc:name="Soap request service -  read Customer payload" doc:id="ffc24aab-0cfd-4076-b9c2-4642aedf50ac">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="soapOperation"><![CDATA["read"]]></ee:set-variable>
					<ee:set-variable resource="dwl/read-customer-in-spp-payload.dwl" variableName="soapServicePayload" />
			</ee:variables>
		</ee:transform>
			<flow-ref doc:name="Call Soap Service - Read Customer"
				doc:id="0b4fe857-3517-4a17-9c7b-150ab976430d"
				name="soap-service-common-subflow" />
			<choice doc:name="Choice" doc:id="f9dbf421-ebcf-43e3-acff-a73a86dd4cfb" >
				<when expression="#[!isEmpty(vars.wscError) or !isEmpty(vars.oaErrorCode)]">
					<set-variable value='#["SPP Read Customer Failed. Detailed Error: " ++ (vars.wscError.description default "") ++ "OA Error Code:" ++ (vars.oaErrorCode default "")]' doc:name="failureReason" doc:id="bc107fb0-1ccd-4f3a-bab3-66d2f2bbc2c9" variableName="failureReason" />
					<raise-error doc:name="Raise error" doc:id="ebf4106c-d8c3-40b5-8b56-3baa00ab637d" type="APP:OPP_PROCESS_ERROR" description='#[vars.failureReason]' />
				</when>
				<otherwise >
					<set-variable value='#[%dw 2.0&#10;output application/json&#10;var customer = payload.body.readResponse.readReturn.objects&#10;---&#10;{&#10;	oaCustomerId: if (customer != null) customer.oaCustomer.id else null,&#10;	oaCustomerName: if (customer != null) customer.oaCustomer.name else null,&#10;	opportunityId: vars.opportunityId,&#10;	customerStatus: if (customer.oaCustomer.id != null) "Existing" else "New"&#10;}]' doc:name="Soap Service response - Extract Customer" doc:id="1f0c9c3c-c8c0-4ce4-bc9d-493f21875b9e" variableName="sppCustomer" />
					<choice doc:name="Choice" doc:id="954d39e5-bc4b-4d9b-b59d-0d8434500311">
				<when expression="#[vars.sppCustomer.oaCustomerId == null]">
					<ee:transform doc:name="Soap request service -  Add Customer" doc:id="3bf094df-6146-4e50-9e3a-786c1f7f9a09">
								<ee:message />
								<ee:variables>
									<ee:set-variable variableName="soapOperation"><![CDATA["add"]]></ee:set-variable>
									<ee:set-variable resource="dwl/create-customer-in-spp-payload.dwl" variableName="soapServicePayload" />
								</ee:variables>
							</ee:transform>
							<flow-ref doc:name="Call Soap Service - Create Customer" doc:id="0cae3782-81a0-4fb4-89c6-14906fae7a05" name="soap-service-common-subflow" />
							<choice doc:name="Choice" doc:id="c02d77d1-fb72-4385-85f6-2fa411a1ac71">
								<when expression="#[!isEmpty(vars.wscError) or !isEmpty(vars.oaErrorCode)]">
									<set-variable value='#["SPP Create Customer Failed. Detailed Error: " ++ (vars.wscError.description default "") ++ "OA Error Code:" ++ (vars.oaErrorCode default "")]' doc:name="failureReason" doc:id="ac74273c-bb1a-40f4-b4ac-bc8ccb01e4b2" variableName="failureReason" />
									<raise-error doc:name="Raise error" doc:id="f379cdf0-2522-4fd2-8e35-ac85b2a42f78" type="APP:OPP_PROCESS_ERROR" description='#[vars.failureReason]' />
								</when>
								<otherwise>
									<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	oaCustomerId: payload.body..*UpdateResult[0].id default null,&#10;	oaCustomerName: vars.currentOpportunity.Account.Name default null,&#10;	opportunityId: vars.opportunityId,&#10;	customerStatus: "Success"&#10;}]' doc:name="Soap Service response - Extract New Customer" doc:id="c31fb0fa-dfec-4840-a20a-a052c6ce610b" variableName="sppCustomer" />
									
								</otherwise>
							</choice>
				</when>
				<otherwise>
					<logger level="INFO" doc:name="Customer Already exists" doc:id="af1cca24-e64c-43bc-aca1-634c58ad32e9" message="#['[correlationId=' ++ (vars.correlationId default '') ++ '] [opportunityId=' ++ vars.opportunityId ++ '] Existing OpenAir Customer found — reusing ID: ' ++ (vars.sppCustomerData.oaCustomerId default 'null')]" category="com.mycompany.sfspp.process-opportunity-subflow" />
				</otherwise>
			</choice>
			<ee:transform doc:name="Query Salesforce - OpportunityLineitem" doc:id="5a3f504d-5bb3-44fa-a723-0b0ae2b7a3ee" >
										<ee:message />
										<ee:variables >
							<ee:set-variable resource="dwl/query-salesforce-object-opportunityLineItem.dwl" variableName="querySalesforceObject" />
										
</ee:variables>
									</ee:transform>
									<flow-ref doc:name="Query Salesforce Object - Opportunity Line Item" doc:id="a30cea4a-36fe-4ab7-87af-181d7ebea5c5" name="common-salesforce-query-sub-flow" />
									<choice doc:name="Choice" doc:id="c7b7f279-9b96-46ee-ae65-468835819ac4" >
										<when expression="#[!isEmpty(vars.sfError)]">
							<logger level="INFO" doc:name="Logger" doc:id="8acf25b3-33f8-4735-8b53-6b356190562b" message='#["Salesforce query opportunity line item failed. Detailed Error: " ++ (vars.sfError default "")]'/>
							<raise-error doc:name="Raise error" doc:id="4dee3d99-8c4d-43b5-b6bb-43cee2f139b3" type="APP:OPP_PROCESS_ERROR" description='#[vars.sfError.description]'/>
										
</when>
										<otherwise >
											<flow-ref doc:name="process-opportunity-line-items" doc:id="fe20fc76-8a83-41ec-afa6-7158ebe1b35d" name="process-opportunity-line-items" />
										</otherwise>
									</choice>
				</otherwise>
				
			</choice>
			<error-handler>
				<on-error-propagate enableNotifications="true"
					logException="true" doc:name="On Error Propagate"
					doc:id="c743260b-6fb6-4cbd-8511-9f5c75f47711" type="APP:OPP_PROCESS_ERROR">
					<ee:transform doc:name="Transform Message" doc:id="45a4e99a-29b0-499c-ac8f-06805032d9c0" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    Id: vars.opportunityId,
    SPP_Sync_Status__c: "Failed"
 }]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="upsateSfObject" ><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-variable>
							<ee:set-variable variableName="sfObject" ><![CDATA["Opportunity"]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<flow-ref doc:name="Mark Opportunity Failed in Salesforce" doc:id="afacd8af-cbec-48d5-a0a5-763445ab06ae" name="update-salesforce-object-subflow" />
				</on-error-propagate>
			</error-handler>
		</try>
	</sub-flow>
	<sub-flow name="process-opportunity-line-items"
		doc:id="b11f31cd-f746-40bb-852a-2e6d5e30ee27">
		<choice doc:name="Decide Based on OpportunityLineItem Query result"
			doc:id="06e083d2-3bcd-4051-8914-0bcfcdf1e147">
			<when
				expression="#[(!isEmpty(payload))]">
				<ee:transform doc:name="Create Variable Lists" doc:id="c93c0b4a-6c27-4bbd-9599-38f364882325">
					<ee:message>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="projectsToCreate" ><![CDATA[%dw 2.0
output application/json
---
[] default []]]></ee:set-variable>
						<ee:set-variable variableName="existingProjectCreationResults" ><![CDATA[%dw 2.0
output application/json
---
[] default []]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<foreach doc:name="Process Each Line Item Sequentially"
					doc:id="doc-3dcb3757" collection="#[payload]">
					<flow-ref name="verify-project-exists-in-spp-subflow" doc:name="verify-project-exists-in-spp-subflow" doc:id="doc-ebf0f037" />
				</foreach>
				<choice doc:name="Projects To Create?" doc:id="doc-4f0096e3">
					<when
						expression="#[sizeOf(vars.projectsToCreate default []) &gt; 0]"
						doc:id="doc-5c1169cf">
						<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;[] default []]" doc:name="Set New Variable for Project Creation Result" doc:id="7058b708-42f6-4a28-868f-c56834ac4ac9" variableName="newProjectCreationResults"/>
						<flow-ref name="batch-create-spp-projects-subflow"
							doc:name="batch-create-spp-projects-subflow"
							doc:id="doc-00472b73" />
					
</when>
					<otherwise doc:id="doc-5c08f660">
						<logger level="INFO"
							message="#['[correlationId=' ++ (vars.correlationId default '') ++ '] [opportunityId=' ++ vars.opportunityId ++ '] [No projects to create — skipping batch creation.']"
							category="com.mycompany.sfspp.process-opportunity-subflow"
							doc:id="doc-cdbc8115" doc:name="No Project to Create" />
					</otherwise>
				</choice>
				<set-variable value="#[%dw 2.0&#10;output application/json&#10;var allProjectResults =(vars.existingProjectCreationResults default []) ++ (vars.newProjectCreationResults default [])&#10;---&#10;allProjectResults]" doc:name="Set Combined New and Existing Project Results" doc:id="c27ee297-a2d3-40ea-bf33-531f30b8ad38" variableName="combinedLineItemResults"/>
				<ee:transform doc:name="Success and Failed results" doc:id="0ce8a426-bb24-4a56-8260-21ed1925c6af">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="successProjects"><![CDATA[%dw 2.0
output application/json
---
(vars.combinedLineItemResults default []) filter ((item) -> item.overallSyncStatus == "Success")]]></ee:set-variable>
				<ee:set-variable variableName="failedOpportunitiesList"><![CDATA[%dw 2.0
output application/json

var failedProjectResults = (vars.combinedLineItemResults default []) filter ((item) -> item.overallSyncStatus == "Failure")

---
(vars.failedOpportunitiesList default [])
++
(if (!isEmpty(failedProjectResults))[{
            opportunityId: failedProjectResults[0].opportunityId default "",
            accountId: vars.accountId default "",
            failureReason: "OPPORTUNITY_PROCESSING_FAILED",
            processResult: failedProjectResults
        }]
    else
        []
)]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
				<flow-ref doc:name="salesforce-writeback" doc:id="c5e6ea97-a545-4938-8e3c-880fe3bf5849" name="salesforce-writeback" />
				<logger level="INFO" doc:name="Logger" doc:id="07b72665-d0c2-4257-ac24-9f432d891b81" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{ &#10;	"OpportunityId" : vars.opportunityId default null,&#10;    "ExistingProjectProcessingResult": vars.existingProjectCreationResults default [],&#10;    "NewProjectProcessingResult": vars.newProjectCreationResults default []&#10;}]'/>
			</when>
			<otherwise>
				<logger level="INFO" doc:name="No Opportunity Line items" doc:id="261ded60-1903-4715-bb77-9d6abce2ec1c" message="#['[correlationId=' ++ (vars.correlationId default '') ++ '] [opportunityId=' ++ vars.opportunityId ++ '] [No Opportunity line items]']" category="com.mycompany.sfspp.process-opportunity-subflow" />
				<ee:transform doc:name="Transform Message" doc:id="70cfbbc1-a2de-4a90-a57d-0a79079590fa">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    Id: vars.opportunityId,
    SPP_Sync_Status__c: "Processed"
 }]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="upsateSfObject"><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-variable>
						<ee:set-variable variableName="sfObject"><![CDATA["Opportunity"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="update-salesforce-object-subflow" doc:id="f7be7e61-3ec5-4343-957c-49de8ceeb76b" name="update-salesforce-object-subflow"/>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="verify-project-exists-in-spp-subflow"
		doc:id="3dfffa82-6c93-4e1b-ad4a-f04e5fccacf3">
		<ee:transform doc:name="Extract Line Item Fields"
			doc:id="9b6289c0-0508-4998-b7c6-68e8fce39f4c">
			<ee:variables
				doc:id="538289d7-2c6c-47ef-ae1c-3368c770e1e9">
				<ee:set-variable variableName="currentLineItem"
					doc:id="0ab1dce1-c68b-4097-b6a0-75cb919ad0bc"><![CDATA[%dw 2.0
output application/json
---
payload
        ]]></ee:set-variable>
				<ee:set-variable variableName="opportunityLineItemId" ><![CDATA[ %dw 2.0
output application/json
---
payload.Id
        ]]></ee:set-variable>

			
</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Call Soap Service -  Read project" doc:id="34f81ccb-ddb5-4113-a6e8-219f8226692c" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="soapOperation" ><![CDATA["read"]]></ee:set-variable>
				<ee:set-variable resource="dwl/read-project-in-spp-payload.dwl" variableName="soapServicePayload" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Soap Service - Read Project"
			doc:id="e8e2f8b3-26b4-457b-a18d-436c1dee40d3"
			name="soap-service-common-subflow" />
		<choice doc:name="Choice" doc:id="9cb60867-5273-4d58-82fb-995e578e40e8" >
			<when expression="#[!isEmpty(vars.wscError) or !isEmpty(vars.oaErrorCode)]">
				<ee:transform doc:name="Set Project Creation Call Failure Result" doc:id="8bbd2669-1563-4ce0-b532-d5a07ade2d9d" >
					<ee:message />
					<ee:variables >
						<ee:set-variable variableName="existingProjectCreationResults" ><![CDATA[%dw 2.0
output application/json
---
vars.existingProjectCreationResults default[] ++ [{
    	opportunityId: vars.opportunityId,
    	sppCustomerId: vars.sppCustomer.oaCustomerId,
    	sppCustomerStatus: vars.sppCustomer.customerStatus,
        opportunityLineItemId: vars.opportunityLineItemId,
        sppProjectId: "",
        hasRelatedDocument:  vars.currentLineItem.Bid_Sheet_ContentDocumentId__c != null,
        sfDocumentId: vars.currentLineItem.Bid_Sheet_ContentDocumentId__c,
        sppProjectStatus: "Failure",
        errorReason: (vars.wscError.description default "") ++ "OA Error Code is:" ++ (vars.oaErrorCode default ""),
        overallSyncStatus: "Failure"
}]]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise >
				<set-variable value='#[%dw 2.0&#10;output application/json&#10;var projectdata = payload.body.readResponse..ReadResult.objects&#10;---&#10;{&#10;	oaProjectId: projectdata.oaProject[0].id default "",&#10;	oaProject_sf_id__c: projectdata.oaProject[0].project_sf_id__c default "",&#10;	oaProjectName: projectdata.oaProject[0].name default "",&#10;	oaProjectStatus: if(projectdata.oaProject[0].id != null) "Existing" else null&#10;}]' doc:name="Soap Service response Payload - Extract line items" doc:id="81f54bcd-aeab-41b6-8b41-5060b6333ec0" variableName="sppProject" />
				<choice doc:name="Project Exists?" doc:id="4743fa7a-c846-4047-a568-c38a4d860db7">
			<when expression="#[!isEmpty(vars.sppProject.oaProjectId)]" doc:id="50d48e27-9b0c-49cd-8d8c-9dfdd0ba0e26">
			
				<choice doc:name="Choice" doc:id="51d075a3-02b6-487d-9178-f5efb3725e16">
				
					<when expression="#[vars.currentLineItem.Bid_Sheet_ContentDocumentId__c != null]">
								<flow-ref name="handle-document-for-existing-project-subflow" doc:name="Handle Document for Existing Project" doc:id="0cac3f6c-466e-4264-8fd6-f32252a7b02c" />
					</when>
					<otherwise>
								<ee:transform doc:name="Set Project Creation Result" doc:id="409bd562-a95f-44cc-90f3-03234e9b4e18" >
									<ee:message />
									<ee:variables >
										<ee:set-variable variableName="existingProjectCreationResults" ><![CDATA[%dw 2.0
output application/json
---
vars.existingProjectCreationResults default []  ++ [{
    	opportunityId: vars.opportunityId,
    	sppCustomerId: vars.sppCustomer.oaCustomerId,
    	sppCustomerStatus: vars.sppCustomer.customerStatus,
        opportunityLineItemId: vars.currentLineItem.Id,
        sppProjectId: vars.sppProject.oaProjectId,
        hasRelatedDocument:  vars.currentLineItem.Bid_Sheet_ContentDocumentId__c != null,
        sfDocumentId: vars.currentLineItem.Bid_Sheet_ContentDocumentId__c,
        sppProjectStatus: "Existing",
        sppAttachmentId: "",
        sppAttachmentStatus: "",
        overallSyncStatus: "Success",
        errorReason: ""
}]]]></ee:set-variable>
									</ee:variables>
								</ee:transform>
					</otherwise>
				</choice>
			
</when>

					<otherwise doc:id="92935b23-87de-40b6-9b28-bcd3361929b4">
				<ee:transform doc:name="Add to Projects To Create" doc:id="196b1bf4-cc7f-4f5c-a393-997eba3a2b6b">
					<ee:variables doc:id="12852bb0-11a6-4e6d-9ee0-1dccd052a478">
								<ee:set-variable variableName="projectsToCreate" ><![CDATA[%dw 2.0
output application/json
---
vars.projectsToCreate ++ [vars.currentLineItem]
            ]]></ee:set-variable>
					
</ee:variables>
				</ee:transform>
			
</otherwise>
		</choice>
			</otherwise>
		</choice>
	</sub-flow>
</mule>