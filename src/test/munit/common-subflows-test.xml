              doc:name="soap-service-common-subflow - SOAP call succeeds"
              description="When WSC consume succeeds, payload is set and wscError remains null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Success"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {readReturn: {ReadResult: {objects: {oaCustomer: {id: 'CUST001', name: 'Test Customer'}}}}}}}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-soap-common-001" doc:name="Set correlationId" />
      <set-variable variableName="soapOperation" value="read" doc:name="Set soapOperation" />
      <set-variable variableName="soapServicePayload" value="#[{}]" doc:name="Set soapServicePayload" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <flow-ref name="soap-service-common-subflow" doc:name="Run soap-service-common-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert wscError is null"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Assert payload body is set" expression="#[payload.body]" is="#[MunitTools::notNullValue()]" />
    
</munit:validation>
  </munit:test>

