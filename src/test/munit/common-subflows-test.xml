        http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd">

  <munit:config name="common-subflows-test" doc:name="MUnit configuration" />

  <!-- ============================================================
       soap-consumer-login-subflow
       Test 1: Login succeeds - soapHeader variable is set, no wscError
       ============================================================ -->
  <munit:test name="soap-login-subflow-success-test"
              doc:name="soap-consumer-login-subflow - login succeeds"
              description="When WSC consume login succeeds, soapHeader variable is set and wscError is null.">

    <munit:behavior>
      <!-- Mock all wsc:consume calls to return a valid login response -->
      <munit-tools:mock-when doc:name="Mock WSC Consume Login Success"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {loginResponse: {loginReturn: {status: '1', sessionId: 'SESSION_001'}}}}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-login-001" doc:name="Set correlationId" />
      <set-variable variableName="runTimestamp" value="2024-01-01T00:00:00Z" doc:name="Set runTimestamp" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <!-- wscError must be null/empty initially so the choice routes to otherwise -->
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <flow-ref name="soap-consumer-login-subflow" doc:name="Run soap-consumer-login-subflow" />
    </munit:execution>

    <munit:validation>
      <!-- wscError should remain null after a successful login -->
      <munit-tools:assert-that doc:name="Assert wscError is null"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::nullValue()]" />
      <!-- soapHeader should be set from soap-header-for-login.dwl -->
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-consumer-login-subflow
       Test 2: Login fails permanently - raises APP:PROCESS_ERROR
       The inner on-error-continue captures wscError, then the choice
       sees !isEmpty(vars.wscError) and raises APP:PROCESS_ERROR
       ============================================================ -->
  <munit:test name="soap-login-subflow-failure-test"
              doc:name="soap-consumer-login-subflow - login fails permanently"
              description="When WSC consume login fails with a permanent error, wscError is set and APP:PROCESS_ERROR is raised."
              expectedErrorType="APP:PROCESS_ERROR">

    <munit:behavior>
      <!-- Mock wsc:consume to throw a permanent SOAP fault -->
      <munit-tools:mock-when doc:name="Mock WSC Consume Login Failure"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:error typeId="WSC:SOAP_FAULT" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-login-002" doc:name="Set correlationId" />
      <set-variable variableName="runTimestamp" value="2024-01-01T00:00:00Z" doc:name="Set runTimestamp" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <flow-ref name="soap-consumer-login-subflow" doc:name="Run soap-consumer-login-subflow" />
    </munit:execution>

    <munit:validation>
      <!-- expectedErrorType handles the assertion; this is a safety check -->
      <munit-tools:assert-that doc:name="Assert error type identifier"
                               expression="#[error.errorType.identifier]"
                               is="#[MunitTools::equalTo('PROCESS_ERROR')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-service-common-subflow
       Test 1: SOAP call succeeds - payload set, wscError null
       ============================================================ -->
