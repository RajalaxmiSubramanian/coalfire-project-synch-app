<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <munit:config name="common-subflows-test" doc:name="MUnit configuration" />

  <!-- ============================================================
       soap-consumer-login-subflow
       Test 1: Login succeeds - soapHeader is set
       ============================================================ -->
  <munit:test name="soap-login-subflow-success-test"
              doc:name="soap-consumer-login-subflow - login succeeds"
              description="When WSC consume login succeeds, soapHeader variable is set and wscError is null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Login"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {loginResponse: {loginReturn: {status: '1', sessionId: 'SESSION_001'}}}}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-login-001" doc:name="Set correlationId" />
      <set-variable variableName="opportunitiesResult" value="#[[]]" doc:name="Set opportunitiesResult" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <set-variable variableName="runTimestamp" value="2024-01-01T00:00:00Z" doc:name="Set runTimestamp" />
      <flow-ref name="soap-consumer-login-subflow" doc:name="Run soap-consumer-login-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert wscError is null"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-consumer-login-subflow
       Test 2: Login fails permanently - raises APP:PROCESS_ERROR
       ============================================================ -->
  <munit:test name="soap-login-subflow-failure-test"
              doc:name="soap-consumer-login-subflow - login fails permanently"
              description="When WSC consume login fails with a permanent error, wscError is set and APP:PROCESS_ERROR is raised."
              expectedErrorType="APP:PROCESS_ERROR">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Login Failure"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:error typeId="WSC:SOAP_FAULT" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-login-002" doc:name="Set correlationId" />
      <set-variable variableName="opportunitiesResult" value="#[[]]" doc:name="Set opportunitiesResult" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <set-variable variableName="runTimestamp" value="2024-01-01T00:00:00Z" doc:name="Set runTimestamp" />
      <flow-ref name="soap-consumer-login-subflow" doc:name="Run soap-consumer-login-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert error type is PROCESS_ERROR"
                               expression="#[error.errorType.identifier]"
                               is="#[MunitTools::equalTo('PROCESS_ERROR')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-service-common-subflow
       Test 1: SOAP call succeeds
       ============================================================ -->
  <munit:test name="soap-service-common-subflow-success-test"
              doc:name="soap-service-common-subflow - SOAP call succeeds"
              description="When WSC consume succeeds, payload is set and wscError remains null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Success"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {ReadResult: {objects: {oaCustomer: {id: 'CUST001'}}}}}}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="soapOperation" value="read" doc:name="Set soapOperation" />
      <set-variable variableName="soapServicePayload" value="#[{}]" doc:name="Set soapServicePayload" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <flow-ref name="soap-service-common-subflow" doc:name="Run soap-service-common-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert wscError is null"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-service-common-subflow
       Test 2: SOAP call fails with permanent error
       ============================================================ -->
  <munit:test name="soap-service-common-subflow-failure-test"
              doc:name="soap-service-common-subflow - SOAP call fails permanently"
              description="When WSC consume fails with a permanent error, wscError is set.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Failure"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:error typeId="WSC:SOAP_FAULT" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="soapOperation" value="read" doc:name="Set soapOperation" />
      <set-variable variableName="soapServicePayload" value="#[{}]" doc:name="Set soapServicePayload" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <flow-ref name="soap-service-common-subflow" doc:name="Run soap-service-common-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert wscError is set"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-service-attachment-subflow
       Test 1: Attachment SOAP call succeeds
       ============================================================ -->
  <munit:test name="soap-service-attachment-subflow-success-test"
              doc:name="soap-service-attachment-subflow - SOAP call succeeds"
              description="When WSC consume for attachment succeeds, payload is set and wscError remains null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Attachment Success"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {addResponse: {addReturn: {UpdateResult: {id: 'ATT001', status: '1'}}}}}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="soapOperation" value="add" doc:name="Set soapOperation" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <flow-ref name="soap-service-attachment-subflow" doc:name="Run soap-service-attachment-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert wscError is null"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       soap-service-attachment-subflow
       Test 2: Attachment SOAP call fails permanently
       ============================================================ -->
  <munit:test name="soap-service-attachment-subflow-failure-test"
              doc:name="soap-service-attachment-subflow - SOAP call fails permanently"
              description="When WSC consume for attachment fails permanently, wscError is set.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock WSC Consume Attachment Failure"
                             processor="wsc:consume">
        <munit-tools:then-return>
          <munit-tools:error typeId="WSC:SOAP_FAULT" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="soapOperation" value="add" doc:name="Set soapOperation" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <flow-ref name="soap-service-attachment-subflow" doc:name="Run soap-service-attachment-subflow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert wscError is set"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       handle-document-for-existing-project-subflow
       Test 1: Document already exists in OpenAir
       ============================================================ -->
  <munit:test name="handle-doc-existing-project-doc-exists-test"
              doc:name="handle-document-for-existing-project-subflow - document already exists"
              description="When SPP read attachment returns an existing document, result is Success with sppAttachmentStatus Existing.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Attachment"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {readReturn: {ReadResult: {objects: {oaAttachment: {id: 'ATT001', file_name: 'test.pdf'}}}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-doc-001" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="existingProjectCreationResults" value="#[[]]" doc:name="Set existingProjectCreationResults" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <set-variable variableName="sppProject"
        value="#[{oaProjectId: 'PROJ001', oaProjectStatus: 'Existing'}]"
        doc:name="Set sppProject" />
      <set-variable variableName="currentLineItem"
        value="#[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: 'DOC001'}]"
        doc:name="Set currentLineItem" />
      <flow-ref name="handle-document-for-existing-project-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert existingProjectCreationResults has one entry"
                               expression="#[sizeOf(vars.existingProjectCreationResults default [])]"
                               is="#[MunitTools::equalTo(1)]" />
      <munit-tools:assert-that doc:name="Assert sppAttachmentStatus is Existing"
                               expression="#[vars.existingProjectCreationResults[0].sppAttachmentStatus]"
                               is="#[MunitTools::equalTo('Existing')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       handle-document-for-existing-project-subflow
       Test 2: Document does NOT exist - create document
       ============================================================ -->
  <munit:test name="handle-doc-existing-project-doc-not-exists-test"
              doc:name="handle-document-for-existing-project-subflow - document not found, create it"
              description="When SPP read attachment returns no document, create-openair-document-subflow-wsc is called.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Attachment Empty"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {readReturn: {ReadResult: {objects: {}}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <munit-tools:mock-when doc:name="Mock Create Document Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="create-openair-document-subflow-wsc" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="createAttachmentResult"
              value="#[{id: 'ATT002', errorReason: ''}]"
              doc:name="Set createAttachmentResult" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-doc-002" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="existingProjectCreationResults" value="#[[]]" doc:name="Set existingProjectCreationResults" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <set-variable variableName="sppProject"
        value="#[{oaProjectId: 'PROJ001', oaProjectStatus: 'Existing'}]"
        doc:name="Set sppProject" />
      <set-variable variableName="currentLineItem"
        value="#[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: 'DOC001'}]"
        doc:name="Set currentLineItem" />
      <flow-ref name="handle-document-for-existing-project-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify create-openair-document-subflow-wsc was called"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="create-openair-document-subflow-wsc" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:assert-that doc:name="Assert existingProjectCreationResults has one entry"
                               expression="#[sizeOf(vars.existingProjectCreationResults default [])]"
                               is="#[MunitTools::equalTo(1)]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       send-failure-notification-subflow
       Test 1: Notification sent successfully
       ============================================================ -->
  <munit:test name="send-failure-notification-subflow-success-test"
              doc:name="send-failure-notification-subflow - notification sent"
              description="When failedOpportunitiesList is non-empty, sent-mail-notification-subflow is called.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Sent Mail Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="sent-mail-notification-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-notif-001" doc:name="Set correlationId" />
      <set-variable variableName="runTimestamp" value="2024-01-01T00:00:00Z" doc:name="Set runTimestamp" />
      <set-variable variableName="failedOpportunitiesList"
        value="#[[{opportunityId: 'OPP001', accountId: 'ACC001', failureReason: 'OPPORTUNITY_PROCESSING_FAILED', processResult: []}]]"
        doc:name="Set failedOpportunitiesList" />
      <flow-ref name="send-failure-notification-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify sent-mail-notification-subflow was called"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="sent-mail-notification-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

</mule>
