  <!-- ============================================================
       handle-document-for-existing-project-subflow
       Test 1: Document already exists in OpenAir
       Read attachment returns a document -> sppAttachmentStatus = Existing
       ============================================================ -->
  <munit:test name="handle-doc-existing-project-doc-exists-test"
              doc:name="handle-document-for-existing-project-subflow - document already exists"
              description="When SPP read attachment returns an existing document, result is Success with sppAttachmentStatus Existing.">

    <munit:behavior>
      <!-- Mock soap-service-common-subflow to return an existing attachment -->
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Attachment Found"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {readReturn: {ReadResult: {objects: {oaAttachment: {id: 'ATT001', file_name: 'test.pdf', ownerid: 'PROJ001'}}}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-doc-exist-001" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="existingProjectCreationResults" value="#[[]]" doc:name="Set existingProjectCreationResults" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <set-variable variableName="sppProject"
        value="#[{oaProjectId: 'PROJ001', oaProjectStatus: 'Existing'}]"
        doc:name="Set sppProject" />
      <set-variable variableName="currentLineItem"
        value="#[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: 'DOC001'}]"
        doc:name="Set currentLineItem" />
      <flow-ref name="handle-document-for-existing-project-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sppAttachmentStatus is Existing"
                               expression="#[vars.existingProjectCreationResults[0].sppAttachmentStatus]"
                               is="#[MunitTools::equalTo('Existing')]" />
      <munit-tools:assert-that doc:name="Assert overallSyncStatus is Success"
                               expression="#[vars.existingProjectCreationResults[0].overallSyncStatus]"
                               is="#[MunitTools::equalTo('Success')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       handle-document-for-existing-project-subflow
       Test 2: Document does NOT exist - create-openair-document-subflow-wsc is called
       ============================================================ -->
  <munit:test name="handle-doc-existing-project-doc-not-exists-test"
              doc:name="handle-document-for-existing-project-subflow - document not found, create it"
              description="When SPP read attachment returns no document, create-openair-document-subflow-wsc is called.">

    <munit:behavior>
      <!-- Mock soap-service-common-subflow to return empty attachment -->
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Attachment Empty"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {readReturn: {ReadResult: {objects: {}}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock create-openair-document-subflow-wsc -->
      <munit-tools:mock-when doc:name="Mock Create Document Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="create-openair-document-subflow-wsc" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="createAttachmentResult"
              value="#[{id: 'ATT002', errorReason: ''}]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-doc-exist-002" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="existingProjectCreationResults" value="#[[]]" doc:name="Set existingProjectCreationResults" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <set-variable variableName="sppProject"
        value="#[{oaProjectId: 'PROJ001', oaProjectStatus: 'Existing'}]"
        doc:name="Set sppProject" />
      <set-variable variableName="currentLineItem"
        value="#[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: 'DOC001'}]"
        doc:name="Set currentLineItem" />
      <flow-ref name="handle-document-for-existing-project-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify create-openair-document-subflow-wsc was called"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="create-openair-document-subflow-wsc" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:assert-that doc:name="Assert sppAttachmentStatus is Success"
                               expression="#[vars.existingProjectCreationResults[0].sppAttachmentStatus]"
                               is="#[MunitTools::equalTo('Success')]" />
    </munit:validation>
  </munit:test>

