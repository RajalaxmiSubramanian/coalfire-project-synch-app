<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <munit:config name="netsuite-spp-subflows-test" doc:name="MUnit configuration" />

  <!-- ============================================================
       batch-create-spp-projects-subflow
       Test 1: SOAP add call succeeds - projects without documents
       All projects succeed, no documents -> newProjectCreationResults populated
       ============================================================ -->
  <munit:test name="batch-create-spp-projects-success-no-doc-test"
              doc:name="batch-create-spp-projects-subflow - SOAP add succeeds, no documents"
              description="When SOAP add call succeeds and projects have no documents, newProjectCreationResults are set with Success.">

    <munit:behavior>
      <!-- Mock soap-service-common-subflow for add projects -->
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Add Projects"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {addResponse: {addReturn: {UpdateResult: [{id: 'PROJ001', status: '1'}, {id: 'PROJ002', status: '1'}]}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-batch-001" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="newProjectCreationResults" value="#[[]]" doc:name="Set newProjectCreationResults" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing', oaCustomerName: 'Test Customer'}]"
        doc:name="Set sppCustomer" />
      <!-- Two line items without documents -->
      <set-variable variableName="projectsToCreate"
        value="#[[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null, PN__c: 'Project A', Product2: {Name: 'Product A', Is_Coalfire_Control__c: 'false'}}, {Id: 'LI002', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null, PN__c: 'Project B', Product2: {Name: 'Product B', Is_Coalfire_Control__c: 'false'}}]]"
        doc:name="Set projectsToCreate" />
      <flow-ref name="batch-create-spp-projects-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert newProjectCreationResults is not null"
                               expression="#[vars.newProjectCreationResults]"
                               is="#[MunitTools::notNullValue()]" />
      <!-- Two projects created successfully, no documents -> 2 entries in results -->
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       batch-create-spp-projects-subflow
       Test 2: SOAP add call fails (wscError set)
       All projects marked as Failure
       ============================================================ -->
  <munit:test name="batch-create-spp-projects-failure-test"
              doc:name="batch-create-spp-projects-subflow - SOAP add fails"
              description="When SOAP add call fails, all projects are marked as Failure in newProjectCreationResults.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Add Projects Failure"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="wscError"
              value="#[{errorType: 'WSC:CONNECTIVITY', description: 'Connection refused'}]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-batch-002" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="newProjectCreationResults" value="#[[]]" doc:name="Set newProjectCreationResults" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing', oaCustomerName: 'Test Customer'}]"
        doc:name="Set sppCustomer" />
      <set-variable variableName="projectsToCreate"
        value="#[[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null, PN__c: 'Project A', Product2: {Name: 'Product A', Is_Coalfire_Control__c: 'false'}}]]"
        doc:name="Set projectsToCreate" />
      <flow-ref name="batch-create-spp-projects-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert newProjectCreationResults is not null"
                               expression="#[vars.newProjectCreationResults]"
                               is="#[MunitTools::notNullValue()]" />
      <!-- When wscError is set, projectfailure is built and added to newProjectCreationResults -->
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       batch-create-spp-projects-subflow
       Test 3: Projects created successfully WITH documents
       create-openair-document-subflow-wsc is called for each project with a document
       ============================================================ -->
  <munit:test name="batch-create-spp-projects-with-documents-test"
              doc:name="batch-create-spp-projects-subflow - projects with documents"
              description="When projects are created successfully and have documents, create-openair-document-subflow-wsc is called for each.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Add Projects With Docs"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {addResponse: {addReturn: {UpdateResult: [{id: 'PROJ001', status: '1'}]}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <munit-tools:mock-when doc:name="Mock Create Document Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="create-openair-document-subflow-wsc" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="createAttachmentResult"
              value="#[{id: 'ATT001', errorReason: ''}]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-batch-003" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="newProjectCreationResults" value="#[[]]" doc:name="Set newProjectCreationResults" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing', oaCustomerName: 'Test Customer'}]"
        doc:name="Set sppCustomer" />
      <!-- One line item WITH a document -->
      <set-variable variableName="projectsToCreate"
        value="#[[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: 'DOC001', PN__c: 'Project A', Product2: {Name: 'Product A', Is_Coalfire_Control__c: 'false'}}]]"
        doc:name="Set projectsToCreate" />
      <flow-ref name="batch-create-spp-projects-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify create-openair-document-subflow-wsc was called once"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="create-openair-document-subflow-wsc" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:assert-that doc:name="Assert sppAttachmentStatus is Success"
                               expression="#[vars.newProjectCreationResults[0].sppAttachmentStatus]"
                               is="#[MunitTools::equalTo('Success')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       batch-create-spp-projects-subflow
       Test 4: Some projects succeed, some fail (OA error code)
       ============================================================ -->
  <munit:test name="batch-create-spp-projects-partial-failure-test"
              doc:name="batch-create-spp-projects-subflow - partial OA error"
              description="When SOAP add returns mixed results (some with OA error status -1), failed projects go to newProjectCreationResults as Failure.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Add Projects Partial Failure"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {addResponse: {addReturn: {UpdateResult: [{id: 'PROJ001', status: '1'}, {id: null, status: '-1', errors: {oaError: {code: '400'}}}]}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock create-openair-document-subflow-wsc for the successful project (no doc) -->
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-batch-004" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="newProjectCreationResults" value="#[[]]" doc:name="Set newProjectCreationResults" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing', oaCustomerName: 'Test Customer'}]"
        doc:name="Set sppCustomer" />
      <set-variable variableName="projectsToCreate"
        value="#[[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null, PN__c: 'Project A', Product2: {Name: 'Product A', Is_Coalfire_Control__c: 'false'}}, {Id: 'LI002', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null, PN__c: 'Project B', Product2: {Name: 'Product B', Is_Coalfire_Control__c: 'false'}}]]"
        doc:name="Set projectsToCreate" />
      <flow-ref name="batch-create-spp-projects-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert newProjectCreationResults is not null"
                               expression="#[vars.newProjectCreationResults]"
                               is="#[MunitTools::notNullValue()]" />
      <!-- One failed project should be in newProjectCreationResults -->
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       create-openair-document-subflow-wsc
       Test 1: SF query succeeds, document created in OpenAir successfully
       ============================================================ -->
  <munit:test name="create-openair-document-subflow-success-test"
              doc:name="create-openair-document-subflow-wsc - document created successfully"
              description="When SF ContentVersion query succeeds and SOAP add attachment succeeds, createAttachmentResult has a valid id.">

    <munit:behavior>
      <!-- Mock common-salesforce-query-sub-flow for ContentVersion -->
      <munit-tools:mock-when doc:name="Mock SF Query Sub-flow - ContentVersion"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="common-salesforce-query-sub-flow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{Title: 'test.pdf', VersionData: ['dGVzdA=='], ContentSize: 4}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="sfError" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock soap-service-attachment-subflow -->
      <munit-tools:mock-when doc:name="Mock SOAP Attachment Sub-flow - Success"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-attachment-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {addResponse: {addReturn: {UpdateResult: {id: 'ATT001', status: '1'}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-doc-create-001" doc:name="Set correlationId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <!-- currentProject is used by query-salesforce-object-ContentVersion.dwl -->
      <set-variable variableName="currentProject"
        value="#[{sppProjectId: 'PROJ001', opportunityLineItemId: 'LI001', hasRelatedDocument: true, sfDocumentId: 'DOC001'}]"
        doc:name="Set currentProject" />
      <set-variable variableName="currentLineItem"
        value="#[{Id: 'LI001', Bid_Sheet_ContentDocumentId__c: 'DOC001'}]"
        doc:name="Set currentLineItem" />
      <flow-ref name="create-openair-document-subflow-wsc" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert createAttachmentResult id is ATT001"
                               expression="#[vars.createAttachmentResult.id]"
                               is="#[MunitTools::equalTo('ATT001')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       create-openair-document-subflow-wsc
       Test 2: SF ContentVersion query fails - createAttachmentResult has empty id
       ============================================================ -->

  <!-- ============================================================
       create-openair-document-subflow-wsc
       Test 3: SOAP attachment add fails - createAttachmentResult has empty id
       ============================================================ -->
  <munit:test name="create-openair-document-subflow-soap-error-test"
              doc:name="create-openair-document-subflow-wsc - SOAP attachment add fails"
              description="When SOAP add attachment fails (wscError set), createAttachmentResult has empty id.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SF Query Sub-flow - ContentVersion Success"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="common-salesforce-query-sub-flow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{Title: 'test.pdf', VersionData: ['dGVzdA=='], ContentSize: 4}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="sfError" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <munit-tools:mock-when doc:name="Mock SOAP Attachment Sub-flow - Error"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-attachment-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="wscError"
              value="#[{errorType: 'WSC:SOAP_FAULT', description: 'SOAP fault occurred'}]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-doc-create-003" doc:name="Set correlationId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="currentProject"
        value="#[{sppProjectId: 'PROJ001', opportunityLineItemId: 'LI001', hasRelatedDocument: true, sfDocumentId: 'DOC001'}]"
        doc:name="Set currentProject" />
      <set-variable variableName="currentLineItem"
        value="#[{Id: 'LI001', Bid_Sheet_ContentDocumentId__c: 'DOC001'}]"
        doc:name="Set currentLineItem" />
      <flow-ref name="create-openair-document-subflow-wsc" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert createAttachmentResult id is empty"
                               expression="#[vars.createAttachmentResult.id]"
                               is="#[MunitTools::equalTo('')]" />
      <munit-tools:assert-that doc:name="Assert createAttachmentResult errorReason is set"
                               expression="#[vars.createAttachmentResult.errorReason]"
                               is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

</mule>
