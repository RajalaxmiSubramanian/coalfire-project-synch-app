                               is="#[MunitTools::equalTo(1)]" />
      <munit-tools:assert-that doc:name="Assert result is Failure"
                               expression="#[vars.existingProjectCreationResults[0].overallSyncStatus]"
                               is="#[MunitTools::equalTo('Failure')]" />
