        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {ReadResult: {objects: {oaProject: [{id: 'PROJ001', project_sf_id__c: 'LI001', name: 'Test Project'}]}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <munit-tools:mock-when doc:name="Mock Handle Document Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="handle-document-for-existing-project-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="existingProjectCreationResults"
              value="#[[{opportunityId: 'OPP001', overallSyncStatus: 'Success'}]]"
