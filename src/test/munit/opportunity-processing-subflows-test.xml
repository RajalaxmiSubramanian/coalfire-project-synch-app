  <!-- ============================================================
       verify-project-exists-in-spp-subflow
       Test 3: SOAP call fails (wscError set)
       ============================================================ -->
  <munit:test name="verify-project-exists-subflow-soap-error-test"
              doc:name="verify-project-exists-in-spp-subflow - SOAP error"
              description="When SOAP read project returns a wscError, the result is added to existingProjectCreationResults as Failure.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Error"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="wscError"
              value="#[{errorType: 'WSC:CONNECTIVITY', description: 'Connection refused'}]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-010" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="existingProjectCreationResults" value="#[[]]" doc:name="Set existingProjectCreationResults" />
      <set-variable variableName="projectsToCreate" value="#[[]]" doc:name="Set projectsToCreate" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <set-payload value="#[{Id: 'LI003', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null}]" doc:name="Set project line item payload" mediaType="application/java" />
      <flow-ref name="verify-project-exists-in-spp-subflow" doc:name="Run Sub-flow" />
