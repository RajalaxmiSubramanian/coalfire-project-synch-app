<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <munit:config name="opportunity-processing-subflows-test" doc:name="MUnit configuration" />

  <!-- ============================================================
       verify-opportunity-exists-and-process-subflow
       Test 1: Empty payload - no opportunities to process
       soap-consumer-login-subflow must NOT be called
       ============================================================ -->
  <munit:test name="verify-opp-subflow-empty-payload-test"
              doc:name="verify-opportunity-exists-and-process-subflow - empty payload"
              description="When payload is empty, the flow logs and ends without calling soap-consumer-login-subflow.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Login Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-consumer-login-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-001" doc:name="Set correlationId" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <!-- opportunitiesResult is empty -> the choice routes to 'when sizeOf == 0' -->
      <set-variable variableName="opportunitiesResult" value="#[[]]" doc:name="Set empty opportunitiesResult" />
      <!-- The sub-flow reads payload for the choice condition -->
      <set-payload value="#[[]]"  doc:name="Set empty payload" />
      <flow-ref name="verify-opportunity-exists-and-process-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify SOAP login was NOT called"
                               processor="flow-ref"
                               times="0">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-consumer-login-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       verify-opportunity-exists-and-process-subflow
       Test 2: Non-empty payload - processes opportunities
       soap-consumer-login-subflow called once, process-opportunity-subflow called once per opp
       ============================================================ -->
  <munit:test name="verify-opp-subflow-with-opportunities-test"
              doc:name="verify-opportunity-exists-and-process-subflow - with opportunities"
              description="When payload has opportunities, soap-consumer-login-subflow is called and each opportunity is processed.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Login Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-consumer-login-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="soapHeader" value="#[{sessionId: 'test-session'}]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <munit-tools:mock-when doc:name="Mock Process Opportunity Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="process-opportunity-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-002" doc:name="Set correlationId" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <set-variable variableName="opportunitiesResult"
        value="#[[{Id: 'OPP001', AccountId: 'ACC001', Name: 'Test Opp 1'}]]"
        doc:name="Set opportunitiesResult" />
      <!-- The sub-flow uses payload for the choice condition (sizeOf(payload default []) == 0) -->
      <set-payload value="#[[{Id: 'OPP001', AccountId: 'ACC001', Name: 'Test Opp 1'}]]"  doc:name="Set payload" />
      <flow-ref name="verify-opportunity-exists-and-process-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify SOAP login was called once"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-consumer-login-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:verify-call doc:name="Verify process-opportunity-subflow was called once"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="process-opportunity-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       process-opportunity-subflow
       Test 1: Read customer succeeds, customer exists (existing customer)
       Flow reuses customer ID and queries line items
       ============================================================ -->
  <munit:test name="process-opp-subflow-existing-customer-test"
              doc:name="process-opportunity-subflow - existing customer found"
              description="When SPP read customer returns an existing customer, the flow reuses the customer ID and queries line items.">

    <munit:behavior>
      <!-- Mock soap-service-common-subflow for read customer - returns existing customer -->
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Customer"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {readResponse: {readReturn: {ReadResult: {objects: {oaCustomer: {id: 'CUST001', name: 'Test Customer'}}}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock common-salesforce-query-sub-flow for line items - returns empty -->
      <munit-tools:mock-when doc:name="Mock SF Query Sub-flow - Line Items Empty"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="common-salesforce-query-sub-flow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[]]" mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="sfError" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock process-opportunity-line-items -->
      <munit-tools:mock-when doc:name="Mock Process Line Items Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="process-opportunity-line-items" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>

      <!-- Mock update-salesforce-object-subflow (called when no line items) -->
      <munit-tools:mock-when doc:name="Mock SF Update Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="update-salesforce-object-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-003" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="accountId" value="ACC001" doc:name="Set accountId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="currentOpportunity"
        value="#[{Id: 'OPP001', AccountId: 'ACC001', Account: {Name: 'Test Account', Long_Account_ID__c: 'ACC001', BillingStreet: '123 Main St', BillingCity: 'Denver', BillingStateCode: 'CO', BillingPostalCode: '80202', BillingCountry: 'US', Phone: '555-1234', Fax: null}}]"
        doc:name="Set currentOpportunity" />
      <flow-ref name="process-opportunity-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sppCustomer customerStatus is Existing"
                               expression="#[vars.sppCustomer.customerStatus]"
                               is="#[MunitTools::equalTo('Existing')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       process-opportunity-subflow
       Test 2: Read customer fails (wscError set)
       Flow raises APP:OPP_PROCESS_ERROR, error handler marks opp as Failed in SF
       ============================================================ -->
  <munit:test name="process-opp-subflow-read-customer-fails-test"
              doc:name="process-opportunity-subflow - read customer fails"
              description="When SPP read customer returns a wscError, the flow raises APP:OPP_PROCESS_ERROR and marks opportunity as Failed."
              expectedErrorType="APP:OPP_PROCESS_ERROR">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Customer Failure"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="wscError"
              value="#[{errorType: 'WSC:CONNECTIVITY', description: 'Connection refused'}]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock update-salesforce-object-subflow (called in error handler to mark opp as Failed) -->
      <munit-tools:mock-when doc:name="Mock SF Update Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="update-salesforce-object-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-004" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="accountId" value="ACC001" doc:name="Set accountId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="currentOpportunity"
        value="#[{Id: 'OPP001', AccountId: 'ACC001', Account: {Name: 'Test Account', Long_Account_ID__c: 'ACC001'}}]"
        doc:name="Set currentOpportunity" />
      <flow-ref name="process-opportunity-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert error identifier is OPP_PROCESS_ERROR"
                               expression="#[error.errorType.identifier]"
                               is="#[MunitTools::equalTo('OPP_PROCESS_ERROR')]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       process-opportunity-subflow
       Test 3: New customer (oaCustomerId null) - create customer succeeds
       ============================================================ -->
  <munit:test name="process-opp-subflow-new-customer-created-test"
              doc:name="process-opportunity-subflow - new customer created successfully"
              description="When SPP read customer returns null oaCustomerId, the flow creates a new customer and continues.">

    <munit:behavior>
      <!-- First call to soap-service-common-subflow: read customer returns null id
           Second call: add customer returns new id
           MUnit mock-when matches ALL calls to this sub-flow with the same mock.
           We use a single mock that returns the add response (simulating the create path). -->
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Returns null customer then new customer"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{body: {addResponse: {addReturn: {UpdateResult: {id: 'NEW_CUST_001', status: '1'}}}}}]"
            mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="wscError" value="#[null]" />
            <munit-tools:variable key="oaErrorCode" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock SF query for line items -->
      <munit-tools:mock-when doc:name="Mock SF Query Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="common-salesforce-query-sub-flow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[]]" mediaType="application/java" />
          <munit-tools:variables>
            <munit-tools:variable key="sfError" value="#[null]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock process-opportunity-line-items -->
      <munit-tools:mock-when doc:name="Mock Process Line Items Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="process-opportunity-line-items" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>

      <!-- Mock update-salesforce-object-subflow -->
      <munit-tools:mock-when doc:name="Mock SF Update Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="update-salesforce-object-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-005" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP002" doc:name="Set opportunityId" />
      <set-variable variableName="accountId" value="ACC002" doc:name="Set accountId" />
      <set-variable variableName="soapHeader" value="#[{sessionId: 'test-session'}]" doc:name="Set soapHeader" />
      <set-variable variableName="wscError" value="#[null]" doc:name="Clear wscError" />
      <set-variable variableName="oaErrorCode" value="#[null]" doc:name="Clear oaErrorCode" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <!-- Pre-set sppCustomer with null oaCustomerId to simulate read returning no customer -->
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: null, oaCustomerName: null, opportunityId: 'OPP002', customerStatus: 'New'}]"
        doc:name="Set sppCustomer with null id" />
      <set-variable variableName="currentOpportunity"
        value="#[{Id: 'OPP002', AccountId: 'ACC002', Account: {Name: 'New Account', Long_Account_ID__c: 'ACC002', BillingStreet: '456 Oak Ave', BillingCity: 'Austin', BillingStateCode: 'TX', BillingPostalCode: '78701', BillingCountry: 'US', Phone: '555-5678', Fax: null}}]"
        doc:name="Set currentOpportunity" />
      <flow-ref name="process-opportunity-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert no wscError"
                               expression="#[vars.wscError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       process-opportunity-line-items
       Test 1: No line items - opportunity marked Success in Salesforce
       ============================================================ -->
  <munit:test name="process-line-items-empty-test"
              doc:name="process-opportunity-line-items - no line items"
              description="When payload is empty, the opportunity is marked Success in Salesforce.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SF Update Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="update-salesforce-object-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-006" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="accountId" value="ACC001" doc:name="Set accountId" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <!-- Empty payload -> the choice routes to 'otherwise' (no line items) -->
      <set-payload value="#[[]]" doc:name="Set empty line item payload"  />
      <flow-ref name="process-opportunity-line-items" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <!-- When no line items, update-salesforce-object-subflow is called to mark opp as Success -->
      <munit-tools:verify-call doc:name="Verify SF update was called once"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="update-salesforce-object-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       process-opportunity-line-items
       Test 2: Line items present, projects to create
       verify-project-exists-in-spp-subflow called per item, batch creation triggered
       ============================================================ -->
  <munit:test name="process-line-items-with-items-test"
              doc:name="process-opportunity-line-items - with line items"
              description="When payload has line items, verify-project-exists-in-spp-subflow is called for each and batch creation is triggered.">

    <munit:behavior>
      <!-- Mock verify-project-exists-in-spp-subflow to add item to projectsToCreate -->
      <munit-tools:mock-when doc:name="Mock Verify Project Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="verify-project-exists-in-spp-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="projectsToCreate"
              value="#[[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null}]]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock batch-create-spp-projects-subflow -->
      <munit-tools:mock-when doc:name="Mock Batch Create Projects Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="batch-create-spp-projects-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="newProjectCreationResults"
              value="#[[{opportunityId: 'OPP001', opportunityLineItemId: 'LI001', sppProjectId: 'PROJ001', overallSyncStatus: 'Success', errorReason: '', sppAttachmentStatus: '', sppAttachmentId: ''}]]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>

      <!-- Mock salesforce-writeback -->
      <munit-tools:mock-when doc:name="Mock Salesforce Writeback Sub-flow"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="salesforce-writeback" />
        </munit-tools:with-attributes>
        <munit-tools:then-return />
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-corr-007" doc:name="Set correlationId" />
      <set-variable variableName="opportunityId" value="OPP001" doc:name="Set opportunityId" />
      <set-variable variableName="accountId" value="ACC001" doc:name="Set accountId" />
      <set-variable variableName="failedOpportunitiesList" value="#[[]]" doc:name="Set failedOpportunitiesList" />
      <set-variable variableName="existingProjectCreationResults" value="#[[]]" doc:name="Set existingProjectCreationResults" />
      <set-variable variableName="projectsToCreate" value="#[[]]" doc:name="Set projectsToCreate" />
      <set-variable variableName="sppCustomer"
        value="#[{oaCustomerId: 'CUST001', customerStatus: 'Existing'}]"
        doc:name="Set sppCustomer" />
      <!-- Non-empty payload -> the choice routes to 'when !isEmpty(payload)' -->
      <set-payload value="#[[{Id: 'LI001', OpportunityId: 'OPP001', Bid_Sheet_ContentDocumentId__c: null, Product2: {Name: 'Test Product'}}]]" doc:name="Set line item payload"  />
      <flow-ref name="process-opportunity-line-items" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:verify-call doc:name="Verify verify-project-exists-in-spp-subflow was called once"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="verify-project-exists-in-spp-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:verify-call doc:name="Verify batch-create-spp-projects-subflow was called"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="batch-create-spp-projects-subflow" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:verify-call doc:name="Verify salesforce-writeback was called"
                               processor="flow-ref"
                               times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="salesforce-writeback" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       verify-project-exists-in-spp-subflow
       Test 1: Project exists in SPP, no document -> existingProjectCreationResults Success
       ============================================================ -->
  <munit:test name="verify-project-exists-subflow-project-found-no-doc-test"
              doc:name="verify-project-exists-in-spp-subflow - project exists, no document"
              description="When SPP read project returns an existing project and line item has no document, result is added to existingProjectCreationResults as Success.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock SOAP Common Sub-flow - Read Project Found"
                             processor="flow-ref">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="name" whereValue="soap-service-common-subflow" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload
