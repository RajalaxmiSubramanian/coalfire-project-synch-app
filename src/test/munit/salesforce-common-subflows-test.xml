<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">

  <munit:config name="salesforce-common-subflows-test" doc:name="MUnit configuration" />

  <!-- ============================================================
       common-salesforce-query-sub-flow
       Test 1: Query succeeds - payload set, sfError null
       ============================================================ -->
  <munit:test name="sf-query-subflow-success-test"
              doc:name="common-salesforce-query-sub-flow - query succeeds"
              description="When Salesforce query succeeds, payload is set and sfError remains null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Query Success"
                             processor="salesforce:query">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[[{Id: 'OPP001', Name: 'Test Opportunity', AccountId: 'ACC001'}]]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-query-001" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="querySalesforceObject"
        value="SELECT Id, Name, AccountId FROM Opportunity WHERE SPP_Sync_Status__c = 'Pending'"
        doc:name="Set querySalesforceObject" />
      <flow-ref name="common-salesforce-query-sub-flow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sfError is null"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       common-salesforce-query-sub-flow
       Test 2: Query fails with permanent error - sfError is set
       ============================================================ -->
  <munit:test name="sf-query-subflow-permanent-error-test"
              doc:name="common-salesforce-query-sub-flow - permanent error"
              description="When Salesforce query fails with a permanent error, sfError is set.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Query Failure"
                             processor="salesforce:query">
        <munit-tools:then-return>
          <munit-tools:error typeId="SALESFORCE:INVALID_INPUT" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-query-002" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="querySalesforceObject"
        value="SELECT Id FROM Opportunity WHERE Invalid_Field__c = 'test'"
        doc:name="Set querySalesforceObject" />
      <flow-ref name="common-salesforce-query-sub-flow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sfError is set"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::notNullValue()]" />
    
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       common-salesforce-query-sub-flow
       Test 3: Query returns empty result - payload empty, sfError null
       ============================================================ -->
  <munit:test name="sf-query-subflow-empty-result-test"
              doc:name="common-salesforce-query-sub-flow - empty result"
              description="When Salesforce query returns empty list, payload is empty and sfError is null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Query Empty"
                             processor="salesforce:query">
        <munit-tools:then-return>
          <munit-tools:payload value="#[[]]" mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-query-003" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="querySalesforceObject"
        value="SELECT Id FROM Opportunity WHERE SPP_Sync_Status__c = 'Pending'"
        doc:name="Set querySalesforceObject" />
      <flow-ref name="common-salesforce-query-sub-flow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sfError is null"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::nullValue()]" />
      <munit-tools:assert-that doc:name="Assert payload is empty"
                               expression="#[sizeOf(payload)]"
                               is="#[MunitTools::equalTo(0)]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       common-salesforce-query-sub-flow
       Test 4: Query fails with transient error (CONNECTIVITY)
       Until-successful retries; after exhaustion sfError is set
       ============================================================ -->
  <munit:test name="sf-query-subflow-transient-error-test"
              doc:name="common-salesforce-query-sub-flow - transient connectivity error"
              description="When Salesforce query fails with a transient connectivity error, until-successful retries and eventually sfError is set.">

    <munit:behavior>
      <!-- CONNECTIVITY is a transient error -> on-error-propagate re-throws for until-successful
           After maxRetries exhausted, the outer on-error-continue catches it and sets sfError -->
      <munit-tools:mock-when doc:name="Mock Salesforce Query Connectivity Error"
                             processor="salesforce:query">
        <munit-tools:then-return>
          <munit-tools:error typeId="SALESFORCE:CONNECTIVITY" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-query-004" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="querySalesforceObject"
        value="SELECT Id FROM Opportunity"
        doc:name="Set querySalesforceObject" />
      <flow-ref name="common-salesforce-query-sub-flow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <!-- After retries exhausted, sfError should be set -->
      <munit-tools:assert-that doc:name="Assert sfError is set after retry exhaustion"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       update-salesforce-object-subflow
       Test 1: Update succeeds - sfError null
       ============================================================ -->
  <munit:test name="sf-update-subflow-success-test"
              doc:name="update-salesforce-object-subflow - update succeeds"
              description="When Salesforce update succeeds, sfError remains null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Update Success"
                             processor="salesforce:update">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{successful: true, items: [{id: 'OPP001', successful: true}]}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-update-001" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="sfObject" value="Opportunity" doc:name="Set sfObject" />
      <set-variable variableName="updateSfObject"
        value="#[[{Id: 'OPP001', SPP_Sync_Status__c: 'Success'}]]"
        doc:name="Set updateSfObject" />
      <flow-ref name="update-salesforce-object-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sfError is null"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       update-salesforce-object-subflow
       Test 2: Update fails with permanent error - sfError is set
       ============================================================ -->
  <munit:test name="sf-update-subflow-permanent-error-test"
              doc:name="update-salesforce-object-subflow - permanent error"
              description="When Salesforce update fails with a permanent error, sfError is set.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Update Failure"
                             processor="salesforce:update">
        <munit-tools:then-return>
          <munit-tools:error typeId="SALESFORCE:INVALID_INPUT" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-update-002" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="sfObject" value="Opportunity" doc:name="Set sfObject" />
      <set-variable variableName="updateSfObject"
        value="#[[{Id: 'OPP001', SPP_Sync_Status__c: 'Failed'}]]"
        doc:name="Set updateSfObject" />
      <flow-ref name="update-salesforce-object-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sfError is set"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::notNullValue()]" />
      <munit-tools:assert-that doc:name="Assert sfError has description"
                               expression="#[vars.sfError.description]"
                               is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       update-salesforce-object-subflow
       Test 3: Update OpportunityLineItem type - succeeds
       ============================================================ -->
  <munit:test name="sf-update-subflow-line-item-test"
              doc:name="update-salesforce-object-subflow - update OpportunityLineItem"
              description="When sfObject is OpportunityLineItem and update succeeds, sfError remains null.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Update Line Item"
                             processor="salesforce:update">
        <munit-tools:then-return>
          <munit-tools:payload
            value="#[{successful: true, items: [{id: 'LI001', successful: true}]}]"
            mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-update-003" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="sfObject" value="OpportunityLineItem" doc:name="Set sfObject" />
      <set-variable variableName="updateSfObject"
        value="#[[{Id: 'LI001', OA_Internal_Id__c: 'PROJ001'}]]"
        doc:name="Set updateSfObject" />
      <flow-ref name="update-salesforce-object-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <munit-tools:assert-that doc:name="Assert sfError is null"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::nullValue()]" />
    </munit:validation>
  </munit:test>

  <!-- ============================================================
       update-salesforce-object-subflow
       Test 4: Update fails with transient error (CONNECTIVITY)
       Until-successful retries; after exhaustion sfError is set
       ============================================================ -->
  <munit:test name="sf-update-subflow-transient-error-test"
              doc:name="update-salesforce-object-subflow - transient connectivity error"
              description="When Salesforce update fails with a transient connectivity error, until-successful retries and eventually sfError is set.">

    <munit:behavior>
      <munit-tools:mock-when doc:name="Mock Salesforce Update Connectivity Error"
                             processor="salesforce:update">
        <munit-tools:then-return>
          <munit-tools:error typeId="SALESFORCE:CONNECTIVITY" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>

    <munit:execution>
      <set-variable variableName="correlationId" value="test-sf-update-004" doc:name="Set correlationId" />
      <set-variable variableName="sfError" value="#[null]" doc:name="Clear sfError" />
      <set-variable variableName="sfObject" value="Opportunity" doc:name="Set sfObject" />
      <set-variable variableName="updateSfObject"
        value="#[[{Id: 'OPP001', SPP_Sync_Status__c: 'Success'}]]"
        doc:name="Set updateSfObject" />
      <flow-ref name="update-salesforce-object-subflow" doc:name="Run Sub-flow" />
    </munit:execution>

    <munit:validation>
      <!-- After retries exhausted, sfError should be set -->
      <munit-tools:assert-that doc:name="Assert sfError is set after retry exhaustion"
                               expression="#[vars.sfError]"
                               is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

</mule>
